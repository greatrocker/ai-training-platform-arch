# ============ Infra ============
COMPOSE_PROJECT_NAME=ai-platform

MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

REDIS_HOST=redis
REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ChangeMe_Str0ng!
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_DATASET=datasets
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_CCTV=cctv-snapshots
MINIO_BUCKET_ALARM=alarm-snapshots
MINIO_BUCKET_REPORTS=reports

# ============ Keycloak / OAuth2 (Page1) ============
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_Str0ng!
OAUTH2_ISSUER=http://keycloak:8080/realms/ai-platform
OAUTH2_ISSUER_PUBLIC=http://localhost:8080/realms/ai-platform
OAUTH2_CLIENT_ID=ai-training-frontend
OAUTH2_CLIENT_SECRET=ChangeMe_FromVault
OAUTH2_REDIRECT_URI=http://localhost/api/auth/callback
JWT_ALGO=RS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_MIN=1440
COOKIE_SIGNING_SECRET=ChangeMe_Str0ng!
FRONTEND_ORIGIN=http://localhost

# ============ Page2 dataset-service ============
DATASET_FRAME_INTERVAL_SEC=1
DATASET_MAX_UPLOAD_GB=50
DATASET_THUMB_SIZE=320
# Whole Windows drives are bind-mounted read-only into dataset-service /
# dataset-worker (see docker-compose.yml) so the "資料集匯入" form can take
# a normal Windows path like D:\Videos\lineA instead of a container path.
# WINDOWS_DRIVE_MOUNTS lists which drive letters are mounted (must match
# the volumes in docker-compose.yml); HOST_WINDOWS_<LETTER> is the actual
# host path docker-compose mounts for that drive.
WINDOWS_DRIVE_MOUNTS=c
HOST_WINDOWS_C=C:\

# ============ Page3 annotation-service ============
ANNOTATION_AI_CONFIDENCE_THRESHOLD=0.6
ANNOTATION_RISK_SCORE_THRESHOLD=0.5
ANNOTATION_VLM_MODEL=qwen2.5-vl-7b
ANNOTATION_AUTO_APPROVE=false

# ============ Page4 training-service ============
TRAINING_GPU_DEVICE=0
TRAINING_MAX_CONCURRENT_JOBS=2
MODEL_REGISTRY_DEFAULT=yolo11n
INCREMENTAL_DEFAULT_REPLAY_RATIO=0.2
INCREMENTAL_DEFAULT_LR=0.001
# Semi-automatic annotation bootstrap (Page3 "auto-label the rest" flow):
# trains a throwaway yolo11n on the dataset's own current annotations, then
# infers on whatever's still unlabeled. Re-run after reviewing to go
# another round — that's the incremental loop.
BOOTSTRAP_EPOCHS=100
BOOTSTRAP_IMG_SIZE=320
BOOTSTRAP_CONF_THRESHOLD=0.15
BOOTSTRAP_MAX_DETECTIONS=3

# ============ Page5 pipeline-service ============
# Fernet key used to encrypt cctv_device RTSP passwords at rest.
# Generate your own with: openssl rand -base64 32 | tr '+/' '-_'
PIPELINE_ENCRYPTION_KEY=changeme-32-byte-fernet-key-000000000000=

# ============ Page6 monitor-service ============
STREAM_PROTOCOL=hls
ALARM_SOUND_ENABLED=true
ALARM_RETENTION_DAYS=90

# ============ Page9 agent-orchestrator (future) ============
AGENT_LLM_PROVIDER=local
AGENT_LLM_MODEL=qwen2.5-14b-instruct
AGENT_REQUIRE_CONFIRM_ABOVE_RISK=medium
AGENT_MAX_AUTO_STEPS=10
AGENT_AUDIT_RETENTION_DAYS=365

VOICE_ASR_MODEL=faster-whisper-large-v3
VOICE_ASR_LANGUAGE=zh
VOICE_HOTWORDS_FILE=/config/hotwords_zh.txt
VOICE_PUSH_TO_TALK=true
VOICE_RETAIN_RAW_AUDIO=false
VOICE_MIN_CONFIRM_CONFIDENCE=0.7

# ============ Report / RAG (future) ============
REPORT_LLM_MODEL=qwen2.5-14b-instruct
REPORT_RETRIEVAL_TOP_K=3
REPORT_STYLE_PROFILE_MIN_SAMPLES=10
REPORT_AUTO_INGEST_ON_APPROVE=true
REPORT_STYLE_REFRESH_INTERVAL_DAYS=14
